<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Best Friends Forever</title>
  <style>
    :root {
      --bg: #fff8fb;
      --bg-2: #ffeef6;
      --panel: rgba(255, 255, 255, 0.8);
      --text: #2d1b2f;
      --soft-text: #6c5870;
      --pink: #ff6fae;
      --pink-dark: #d94f90;
      --rose: #ffb4d9;
      --lavender: #d9c6ff;
      --peach: #ffd7b5;
      --gold: #ffd76a;
      --border: rgba(125, 84, 119, 0.12);
      --shadow: rgba(205, 96, 155, 0.15);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; }

    body {
      font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
      background: linear-gradient(180deg, var(--bg), var(--bg-2));
      color: var(--text);
      line-height: 1.6;
    }

    a { text-decoration: none; color: inherit; }
    img { max-width: 100%; display: block; }

    .container {
      width: min(1180px, 90%);
      margin: 0 auto;
    }

    header {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(255, 248, 251, 0.7);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border);
    }

    nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      min-height: 78px;
      gap: 20px;
    }

    .brand {
      font-size: 1.45rem;
      font-weight: 800;
      letter-spacing: 0.04em;
      color: var(--pink-dark);
    }

    .brand span {
      color: var(--text);
    }

    .nav-links {
      display: flex;
      gap: 24px;
      align-items: center;
      color: var(--soft-text);
      font-weight: 600;
    }

    .nav-links a:hover {
      color: var(--pink-dark);
    }

    .nav-btn {
      background: linear-gradient(135deg, var(--pink), var(--pink-dark));
      color: white;
      border: none;
      border-radius: 999px;
      padding: 12px 20px;
      font-weight: 700;
      cursor: pointer;
      box-shadow: 0 12px 28px rgba(217, 79, 144, 0.28);
    }

    .hero {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 36px;
      align-items: center;
      min-height: 82vh;
      padding: 70px 0 50px;
    }

    .badge {
      display: inline-block;
      background: var(--panel);
      border: 1px solid var(--border);
      color: var(--pink-dark);
      padding: 10px 16px;
      border-radius: 999px;
      font-weight: 700;
      margin-bottom: 18px;
      box-shadow: 0 12px 30px var(--shadow);
    }

    h1 {
      font-size: clamp(2.8rem, 6vw, 5rem);
      line-height: 1.06;
      letter-spacing: -0.05em;
      margin-bottom: 18px;
    }

    .highlight {
      background: linear-gradient(135deg, var(--pink), var(--lavender));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .hero p {
      color: var(--soft-text);
      font-size: 1.08rem;
      max-width: 620px;
      margin-bottom: 26px;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-bottom: 24px;
    }

    .primary-btn, .secondary-btn {
      border-radius: 999px;
      padding: 14px 22px;
      font-weight: 800;
      cursor: pointer;
      transition: transform 0.2s ease;
      border: none;
    }

    .primary-btn {
      background: linear-gradient(135deg, var(--pink), var(--pink-dark));
      color: white;
      box-shadow: 0 18px 38px rgba(217, 79, 144, 0.25);
    }

    .secondary-btn {
      border: 1px solid var(--border);
      background: rgba(255,255,255,0.35);
      color: var(--text);
    }

    .primary-btn:hover, .secondary-btn:hover, .nav-btn:hover {
      transform: translateY(-2px);
    }

    .stats {
      display: flex;
      flex-wrap: wrap;
      gap: 18px;
      color: var(--soft-text);
      font-weight: 700;
    }

    .stats span {
      background: rgba(255,255,255,0.45);
      border: 1px solid var(--border);
      padding: 10px 14px;
      border-radius: 999px;
      box-shadow: 0 10px 20px rgba(0,0,0,0.02);
    }

    .hero-visual {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 520px;
    }

    .shape {
      position: absolute;
      width: 420px;
      height: 420px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(255, 111, 174, 0.33), rgba(217,198,255,0.2), transparent 68%);
      filter: blur(30px);
      animation: float 6s ease-in-out infinite;
    }

    @keyframes float {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-18px); }
    }

    .photo-card {
      position: relative;
      width: min(460px, 90%);
      background: rgba(255,255,255,0.7);
      border: 1px solid var(--border);
      border-radius: 32px;
      padding: 18px;
      box-shadow: 0 25px 60px var(--shadow);
      z-index: 1;
    }

    .photo-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 8px 6px 18px;
      color: var(--soft-text);
      font-weight: 700;
    }

    .dots {
      display: flex;
      gap: 8px;
    }

    .dots span {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: #ff7d7d;
    }

    .dots span:nth-child(2) { background: #ffd76a; }
    .dots span:nth-child(3) { background: #7ee7a1; }

    .memory-frame {
      background: linear-gradient(135deg, #ffdfe9, #e8dcff, #ffe5c4);
      border-radius: 24px;
      height: 420px;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
      border: 1px solid rgba(125,84,119,0.15);
    }

    .heart {
      position: absolute;
      font-size: 7rem;
      color: rgba(255, 111, 174, 0.28);
      transform: rotate(-12deg);
    }

    .picture {
      position: absolute;
      width: 220px;
      height: 220px;
      border-radius: 50%;
      background: linear-gradient(135deg, #ffc0d9, #cfc0ff);
      border: 10px solid rgba(255,255,255,0.5);
      box-shadow: 0 18px 30px rgba(115, 75, 120, 0.18);
      display: grid;
      place-items: center;
      font-size: 4rem;
      font-weight: 700;
      color: rgba(255,255,255,0.9);
    }

    .caption {
      position: absolute;
      bottom: 22px;
      left: 20px;
      right: 20px;
      background: rgba(255,255,255,0.55);
      border: 1px solid rgba(255,255,255,0.5);
      color: var(--text);
      border-radius: 16px;
      padding: 14px 16px;
      font-weight: 700;
      text-align: center;
    }

    section {
      padding: 90px 0;
    }

    .section-heading {
      text-align: center;
      max-width: 700px;
      margin: 0 auto 40px;
    }

    .section-heading h2 {
      font-size: clamp(2.1rem, 3vw, 3rem);
      margin-bottom: 12px;
    }

    .section-heading p {
      color: var(--soft-text);
    }

    .features {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 22px;
    }

    .feature-card {
      background: rgba(255,255,255,0.55);
      backdrop-filter: blur(6px);
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 28px;
      box-shadow: 0 